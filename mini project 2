        "# ==================== PROJECT 2: MODEL COMPARISON ====================\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from xgboost import XGBClassifier\n",
        "from sklearn.metrics import accuracy_score, confusion_matrix\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. DATA PREPARATION (16 participants)\n",
        "data = {\n",
        "    'Participant': range(1, 17),\n",
        "    'Congruent_RT': [450, 420, 510, 480, 390, 470, 430, 500,\n",
        "                    460, 440, 490, 410, 530, 450, 470, 420],\n",
        "    'Incongruent_RT': [620, 580, 650, 700, 590, 630, 610, 680,\n",
        "                      640, 600, 670, 580, 720, 630, 650, 590]\n",
        "}\n",
        "df = pd.DataFrame(data)\n",
        "df['Interference'] = df['Incongruent_RT'] - df['Congruent_RT']\n",
        "\n",
        "# 2. LABELING (High/Low Interference)\n",
        "df['High_Interference'] = (df['Interference'] > df['Interference'].median()).astype(int)\n",
        "\n",
        "# 3. MODEL TRAINING\n",
        "X = df[['Congruent_RT', 'Incongruent_RT']]\n",
        "y = df['High_Interference']\n",
        "\n",
        "models = {\n",
        "    \"Neural Network\": MLPClassifier(hidden_layer_sizes=(100,), max_iter=1000, random_state=42),\n",
        "    \"Random Forest\": RandomForestClassifier(random_state=42),\n",
        "    \"XGBoost\": XGBClassifier(random_state=42)\n",
        "}\n",
        "\n",
        "# 4. RESULTS\n",
        "print(\"=== MODEL PERFORMANCE ===\")\n",
        "for name, model in models.items():\n",
        "    model.fit(X, y)\n",
        "    y_pred = model.predict(X)\n",
        "    acc = accuracy_score(y, y_pred)\n",
        "    cm = confusion_matrix(y, y_pred)\n",
        "\n",
        "    print(f\"\\n{name}:\")\n",
        "    print(f\"Accuracy: {acc:.1%}\")\n",
        "    print(\"Confusion Matrix:\")\n",
        "    print(cm)\n",
        "\n",
        "    # Feature importance (for tree-based models)\n",
        "    if hasattr(model, 'feature_importances_'):\n",
        "        plt.figure(figsize=(6, 3))\n",
        "        plt.bar(X.columns, model.feature_importances_)\n",
        "        plt.title(f\"{name} Feature Importance\")\n",
        "        plt.show()\n",
        "\n",
        "# 5. STATISTICAL SUMMARY\n",
        "print(\"\\n=== STATISTICAL SUMMARY ===\")\n",
        "print(f\"Median Interference Effect: {df['Interference'].median():.1f} ms\")\n",
        "print(f\"High Interference Cases: {sum(df['High_Interference'])}/16 participants\")"
      ]
