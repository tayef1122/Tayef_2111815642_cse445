        "# PROJECT 1 - PERFORMANCE GROUPS\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.tree import DecisionTreeClassifier, plot_tree\n",
        "from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay\n",
        "\n",
        "# ======================\n",
        "# Step 1: Load Data\n",
        "# ======================\n",
        "data = {\n",
        "    'Participant': range(1, 17),\n",
        "    'Congruent_RT': [450, 420, 510, 480, 390, 470, 430, 500,\n",
        "                     460, 440, 490, 410, 530, 450, 470, 420],\n",
        "    'Incongruent_RT': [620, 580, 650, 700, 590, 630, 610, 680,\n",
        "                       640, 600, 670, 580, 720, 630, 650, 590]\n",
        "}\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Save dataset\n",
        "df.to_csv(\"participants_data.csv\", index=False)\n",
        "\n",
        "# Add Interference column\n",
        "df['Interference'] = df['Incongruent_RT'] - df['Congruent_RT']\n",
        "\n",
        "# ======================\n",
        "# Step 2: KMeans Clustering\n",
        "# ======================\n",
        "kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
        "df['Group'] = kmeans.fit_predict(df[['Interference']])\n",
        "\n",
        "# Relabel groups as Low, Medium, High based on mean interference\n",
        "cluster_means = df.groupby('Group')['Interference'].mean().sort_values()\n",
        "ordered_labels = {cluster: label for cluster, label in zip(cluster_means.index,\n",
        "                                                          ['Low', 'Medium', 'High'])}\n",
        "df['Performance'] = df['Group'].map(ordered_labels)\n",
        "\n",
        "# ======================\n",
        "# Step 3: Visualization of Groups\n",
        "# ======================\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.scatter(df['Participant'], df['Interference'], c=df['Group'], cmap='rainbow')\n",
        "plt.title(\"Participant Performance Groups\")\n",
        "plt.xlabel(\"Participant ID\")\n",
        "plt.ylabel(\"Interference Effect (ms)\")\n",
        "plt.savefig(\"Data_Visualize.jpg\")\n",
        "plt.show()\n",
        "\n",
        "# ======================\n",
        "# Step 4: Decision Tree Classification\n",
        "# ======================\n",
        "X = df[['Congruent_RT', 'Incongruent_RT']]\n",
        "y = df['Performance']\n",
        "\n",
        "tree = DecisionTreeClassifier(max_depth=2, random_state=42)\n",
        "tree.fit(X, y)\n",
        "\n",
        "plt.figure(figsize=(12, 6))\n",
        "plot_tree(tree,\n",
        "          feature_names=['Congruent RT', 'Incongruent RT'],\n",
        "          class_names=tree.classes_, filled=True)\n",
        "plt.show()\n",
        "\n",
        "# ======================\n",
        "# Step 5: Confusion Matrix\n",
        "# ======================\n",
        "y_pred = tree.predict(X)\n",
        "cm = confusion_matrix(y, y_pred, labels=tree.classes_)\n",
        "disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=tree.classes_)\n",
        "disp.plot(cmap=\"Blues\")\n",
        "plt.title(\"Decision Tree Confusion Matrix\")\n",
        "plt.savefig(\"Confusion_Matrix.jpg\")\n",
        "plt.show()\n",
        "\n",
        "# ======================\n",
        "# Final Output Table\n",
        "# ======================\n",
        "print(\"\\n=== Participant Performance Groups ===\")\n",
        "print(df[['Participant','Congruent_RT','Incongruent_RT','Interference','Performance']])\n"
      ]
